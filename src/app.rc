#include <windows.h>
2 ICON "quiettype.ico"
1 RT_MANIFEST "app.manifest"
100 DIALOGEX 0,0,374,318
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "QuietType settings"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "QuietType",110,23,14,155,14
 LTEXT "Dictation settings",111,22,30,190,28
 LTEXT "",112,30,64,108,12
 LTEXT "Keyboard &shortcut",113,34,108,145,14
 LTEXT "Select the field and press your keys.",120,34,123,164,13
 CONTROL "",101,"msctls_hotkey32",WS_TABSTOP | WS_BORDER,197,110,143,18
 LTEXT "&Activation",114,34,148,146,14
 LTEXT "Hold the shortcut or press it twice.",121,34,163,170,13
 CONTROL "&Hold to talk",102,"Button",BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP,197,149,69,22
 CONTROL "Press to &toggle",105,"Button",BS_AUTORADIOBUTTON | BS_PUSHLIKE,270,149,70,22
 LTEXT "&Microphone",115,34,188,145,14,WS_GROUP
 LTEXT "Uses your Windows default unless changed.",122,34,203,165,13
 COMBOBOX 103,197,191,143,95,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "Start QuietType &when I sign in",104,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,34,237,280,16
 LTEXT "Esc cancels a dictation.",123,23,285,166,13
 PUSHBUTTON "Cancel",IDCANCEL,191,279,57,25
 DEFPUSHBUTTON "Save changes",IDOK,254,279,96,25
END
